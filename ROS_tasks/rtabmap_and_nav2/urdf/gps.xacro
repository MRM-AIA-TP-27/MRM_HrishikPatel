<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot">

  
  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
      <origin xyz="0.1 0 0.12" rpy="0 0 0"/>
    </joint>


  <link name="gps_link">
    <visual>
      <geometry><cylinder radius="0.04" length="0.02"/></geometry>
    </visual>
    <collision>
      <geometry><cylinder radius="0.04" length="0.02"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <gazebo reference="gps_link">
    <sensor name="gps_sensor" type="gps">
        <always_on>true</always_on>
        <update_rate>10.0</update_rate>
        <plugin name="gps_controller" filename="libgazebo_ros_gps_sensor.so">
            <ros>
                <!-- <namespace>/br</namespace> -->
                <remapping>gps_controller/out:=gps</remapping>
            </ros>
            <frame_name>gps_joint</frame_name>
            <horizontal_position_std_dev>0.0</horizontal_position_std_dev>
            <vertical_position_std_dev>0.0</vertical_position_std_dev>

        </plugin>
    </sensor>
  </gazebo>

  </robot>
